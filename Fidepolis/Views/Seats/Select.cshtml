@model SeatsVm
@{ ViewData["Title"] = "Elegir asientos"; }
<a class="back" asp-controller="Movies" asp-action="Details" asp-route-id="@Model.Movie.Id">← Volver a funciones</a>
<div class="page-heading"><p class="eyebrow">PASO 1 DE 2</p><h1>Elegí tus asientos</h1><p class="muted">@Model.Movie.Title · @Model.Showtime.StartsAt.ToString("dd/MM/yyyy hh:mm tt") · @Model.Showtime.Room</p></div>
@if (!string.IsNullOrEmpty(Model.Message)) { <div class="notice warning" role="alert">@Model.Message</div> }
<div class="seat-layout"><div class="seat-board"><div class="screen">PANTALLA</div><div class="seat-grid" id="seatGrid" aria-label="Asientos disponibles">
@foreach (var row in "ABCDE") { @for (int column = 1; column <= 8; column++) { var seat = $"{row}{column}"; var occupied = Model.Occupied.Contains(seat); var selected = Model.Selected.Contains(seat); <button type="button" data-seat="@seat" class="seat @(occupied ? "occupied" : selected ? "selected" : "")" disabled="@occupied" aria-pressed="@(selected ? "true" : "false")" title="Asiento @seat">@seat</button> } }
</div><div class="legend"><span><i class="key available"></i> Disponible</span><span><i class="key selected"></i> Seleccionado</span><span><i class="key occupied"></i> Ocupado</span></div></div>
<aside class="summary-card"><h2>Tu selección</h2><p class="muted">Máximo 6 entradas por compra</p><p>Asientos: <strong id="selectedLabel">Ninguno</strong></p><div class="summary-line"><span>Entradas</span><strong id="quantity">0</strong></div><div class="summary-line"><span>Precio por entrada</span><strong>₡@Model.Showtime.Price.ToString("N0")</strong></div><div class="summary-line total"><span>Total estimado</span><strong id="total">₡0</strong></div><p id="seatMessage" class="inline-error" role="alert"></p><form asp-controller="Seats" asp-action="Continue" method="post" id="seatForm">@Html.AntiForgeryToken()<input type="hidden" name="showtimeId" value="@Model.Showtime.Id" /><input type="hidden" name="seatCodes" id="seatCodes" /><button class="btn btn-accent btn-full" id="continueButton" disabled>Continuar a compra →</button></form><p class="tiny muted">Los asientos se verifican nuevamente al confirmar.</p></aside></div>
@section Scripts { <script>window.fidepolisSeats = { showtimeId: @Model.Showtime.Id, price: @((int)Model.Showtime.Price), selected: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Selected)) };</script><script src="~/js/seats.js" asp-append-version="true"></script> }
