@model CatalogVm
@{ ViewData["Title"] = "Cartelera"; }
<section class="hero"><p class="eyebrow">BIENVENIDO A FIDEPOLIS</p><h1>Historias que se viven <em>en grande.</em></h1><p>Descubrí las películas disponibles y elegí tu próxima función.</p><a class="btn btn-accent" href="#cartelera">Explorar cartelera</a></section>
<section id="cartelera" class="section-head"><div><p class="eyebrow">EN PANTALLA</p><h2>Cartelera actual</h2></div><span class="muted">@Model.Movies.Count película(s)</span></section>
<form method="get" class="filters" asp-action="Index"><label>Buscar por título<input type="search" name="search" value="@Model.Search" placeholder="Nombre de la película" /></label><label>Filtrar por género<select name="genre"><option value="">Todos los géneros</option>@foreach (var genre in Model.Genres){ if (genre == Model.Genre) { <option value="@genre" selected>@genre</option> } else { <option value="@genre">@genre</option> } }</select></label><button class="btn btn-accent" type="submit">Buscar</button><a class="btn btn-ghost" asp-action="Index">Limpiar</a></form>
@if (!Model.Movies.Any()) { <div class="notice">No encontramos películas para esa búsqueda. Probá con otro título o género.</div> }
else { <div class="movie-grid">@foreach (var movie in Model.Movies) { <article class="movie-card"><a asp-action="Details" asp-route-id="@movie.Id" class="poster-link"><img class="poster" src="@movie.Poster" alt="Póster de @movie.Title" /></a><div class="movie-info"><span class="pill">@movie.Classification</span><h3>@movie.Title</h3><p>@movie.Genre</p><a class="btn btn-ghost btn-full" asp-action="Details" asp-route-id="@movie.Id">Ver película y funciones →</a></div></article> }</div> }
