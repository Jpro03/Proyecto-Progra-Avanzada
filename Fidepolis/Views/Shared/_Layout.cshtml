<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content="Cartelera y entradas de cine Fidepolis" />
<title>@ViewData["Title"] | Fidepolis</title>
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="topbar"><nav class="container nav" aria-label="Navegación principal">
<a class="brand" asp-controller="Movies" asp-action="Index"><span class="brand-icon">✦</span> FIDEPOLIS<span class="brand-light">CINEMA</span></a>
<div class="navlinks"><a asp-controller="Movies" asp-action="Index">Cartelera</a><a asp-controller="Purchases" asp-action="Lookup">Consultar compra</a></div>
</nav></header>
<main class="container content">@RenderBody()</main>
<footer class="footer"><div class="container">Fidepolis · Proyecto académico de compra simulada · No se realizan cobros reales</div></footer>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
