@model ReceiptVm
@{ ViewData["Title"] = "Detalle de compra"; }
<a class="back" asp-action="Lookup">← Consultar otro código</a><div class="receipt"><p class="eyebrow">DETALLE DE TU COMPRA</p><h1>@Model.Movie.Title</h1><div class="booking-code">@Model.Purchase.Code</div>@if (!string.IsNullOrEmpty(TempData["CancelResult"]?.ToString())) { <div class="notice">@TempData["CancelResult"]</div> }<span class="pill">@(Model.Purchase.IsCanceled ? "Cancelada" : "Confirmada")</span><div class="receipt-details"><div><span>Comprador</span><strong>@Model.Purchase.BuyerName</strong></div><div><span>Correo</span><strong>@Model.Purchase.BuyerEmail</strong></div><div><span>Película</span><strong>@Model.Movie.Title</strong></div><div><span>Fecha y hora</span><strong>@Model.Showtime.StartsAt.ToString("dd/MM/yyyy hh:mm tt")</strong></div><div><span>Sala</span><strong>@Model.Showtime.Room</strong></div><div><span>Asientos</span><strong>@string.Join(", ", Model.Purchase.Seats)</strong></div><div><span>Entradas</span><strong>@Model.Purchase.Seats.Count</strong></div><div><span>Total</span><strong>₡@Model.Purchase.Total.ToString("N0")</strong></div></div><div class="actions"><a asp-controller="Movies" asp-action="Index" class="btn btn-ghost">Volver a cartelera</a>@if (!Model.Purchase.IsCanceled && Model.Showtime.StartsAt > DateTime.Now) { <form asp-action="Cancel" method="post" onsubmit="return confirm('¿Seguro que deseás cancelar la compra?');">@Html.AntiForgeryToken()<input type="hidden" name="code" value="@Model.Purchase.Code" /><button class="btn btn-danger" type="submit">Cancelar compra</button></form> }</div></div>
