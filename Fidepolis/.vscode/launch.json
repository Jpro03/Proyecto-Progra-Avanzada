{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Fidepolis (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/Fidepolis.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "serverReadyAction": { "action": "openExternally", "pattern": "Now listening on: (https?://\\S+)" },
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" }
    }
  ]
}
