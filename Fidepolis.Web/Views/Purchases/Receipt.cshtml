@model ReceiptVm
@{ ViewData["Title"] = "Compra exitosa"; }
<div class="receipt"><div class="success-icon">✓</div><p class="eyebrow">COMPRA REGISTRADA</p><h1>¡Tu compra fue exitosa!</h1><p class="muted">Conservá este código para consultar o cancelar tu compra.</p><div class="booking-code" id="bookingCode">@Model.Purchase.Code</div><button type="button" class="btn btn-ghost" onclick="navigator.clipboard.writeText(document.getElementById('bookingCode').textContent)">Copiar código</button><div class="receipt-details"><div><span>Comprador</span><strong>@Model.Purchase.BuyerName</strong></div><div><span>Correo</span><strong>@Model.Purchase.BuyerEmail</strong></div><div><span>Película</span><strong>@Model.Movie.Title</strong></div><div><span>Función</span><strong>@Model.Showtime.StartsAt.ToString("dd/MM/yyyy hh:mm tt")</strong></div><div><span>Sala</span><strong>@Model.Showtime.Room</strong></div><div><span>Asientos</span><strong>@string.Join(", ", Model.Purchase.Seats)</strong></div><div><span>Entradas</span><strong>@Model.Purchase.Seats.Count</strong></div><div><span>Total pagado (simulado)</span><strong>₡@Model.Purchase.Total.ToString("N0")</strong></div></div><div class="actions"><a class="btn btn-accent" asp-action="Details" asp-route-code="@Model.Purchase.Code">Consultar detalle</a><a class="btn btn-ghost" asp-controller="Movies" asp-action="Index">Volver a cartelera</a></div></div>
