@model CheckoutVm
@{ ViewData["Title"] = "Confirmar compra"; }
<a class="back" asp-controller="Seats" asp-action="Select" asp-route-id="@Model.ShowtimeId" asp-route-selected="@Model.SeatCodes">← Cambiar asientos</a>
<div class="page-heading"><p class="eyebrow">PASO 2 DE 2</p><h1>Confirmá tu compra</h1><p class="muted">Esta es una compra simulada. No se solicitan datos bancarios.</p></div>
<div class="checkout-layout"><form asp-action="Confirm" method="post" class="form-panel">@Html.AntiForgeryToken()<input asp-for="ShowtimeId" type="hidden" /><input asp-for="SeatCodes" type="hidden" /><h2>Datos del comprador</h2><div asp-validation-summary="ModelOnly" class="inline-error"></div><label asp-for="BuyerName">Nombre completo</label><input asp-for="BuyerName" autocomplete="name" maxlength="80" placeholder="Tu nombre completo" /><span asp-validation-for="BuyerName" class="inline-error"></span><label asp-for="BuyerEmail">Correo electrónico</label><input asp-for="BuyerEmail" autocomplete="email" maxlength="150" placeholder="nombre@ejemplo.com" /><span asp-validation-for="BuyerEmail" class="inline-error"></span><button type="submit" class="btn btn-accent btn-full">Confirmar compra simulada</button></form><aside class="summary-card"><h2>Resumen de compra</h2><h3>@Model.Movie!.Title</h3><p class="muted">@Model.Showtime!.StartsAt.ToString("dd/MM/yyyy hh:mm tt")<br />@Model.Showtime.Room · @Model.Showtime.Language</p><div class="summary-line"><span>Asientos</span><strong>@string.Join(", ", Model.Seats)</strong></div><div class="summary-line"><span>Entradas</span><strong>@Model.Seats.Count</strong></div><div class="summary-line"><span>Precio unitario</span><strong>₡@Model.Showtime.Price.ToString("N0")</strong></div><div class="summary-line total"><span>Total</span><strong>₡@Model.Total.ToString("N0")</strong></div></aside></div>
